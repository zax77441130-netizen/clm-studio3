{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clm-studio3",
  "main": "worker.py",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "SITE_KV",
      "id": "e059ce599dc64b8b94d1cbebb992cf5a"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true
  }
}
