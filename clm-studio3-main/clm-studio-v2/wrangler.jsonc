{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clm-studio3",
  "main": "worker.py",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/uploads/*", "/robots.txt", "/sitemap.xml", "/portfolio/*"]
  },
  "kv_namespaces": [
    {
      "binding": "SITE_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "clm-studio3-uploads"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true
  }
}
